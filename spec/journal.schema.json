{
  "$defs": {
    "Actor": {
      "description": "Who made a change. Free-form so hosts can use their own ids (`\"user:42\"`, `\"model:brush-clean-1\"`).",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActorKind"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "person",
        "model",
        "app"
      ],
      "type": "string"
    },
    "BoxRegion": {
      "additionalProperties": false,
      "description": "An oriented box: `center` and full `size` in meters, turned by `yawDeg` degrees about +y.",
      "properties": {
        "center": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "size": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "yawDeg": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "center",
        "size"
      ],
      "type": "object"
    },
    "Brush": {
      "oneOf": [
        {
          "const": "draw",
          "description": "Raise the surface along its average normal (lower it with `invert`).",
          "type": "string"
        },
        {
          "const": "inflate",
          "description": "Push each vertex out along its own normal: swells shapes (shrinks with `invert`).",
          "type": "string"
        },
        {
          "const": "smooth",
          "description": "Relax toward the neighbours' average: removes bumps and noise.",
          "type": "string"
        },
        {
          "const": "flatten",
          "description": "Pull vertices onto the plane that best fits the area under the brush.",
          "type": "string"
        },
        {
          "const": "pinch",
          "description": "Pull vertices toward the brush centre along the surface: sharpens creases (spreads with `invert`).",
          "type": "string"
        },
        {
          "const": "paint",
          "description": "Blend the vertex colours toward `color`.",
          "type": "string"
        }
      ]
    },
    "Dab": {
      "additionalProperties": false,
      "description": "One brush touch. `pressure` (0..1) scales strength, as from a pen.",
      "properties": {
        "center": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "pressure": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "center"
      ],
      "type": "object"
    },
    "Op": {
      "description": "One edit.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Delete the faces whose centroid is inside the box, or with `invert` every face outside it. Vertices no face uses\nany more are dropped. Count: faces removed.",
          "properties": {
            "box": {
              "$ref": "#/$defs/BoxRegion"
            },
            "invert": {
              "default": false,
              "type": "boolean"
            },
            "op": {
              "const": "removeBox",
              "type": "string"
            }
          },
          "required": [
            "op",
            "box"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Cut the box out of the surface. Triangles crossing its boundary are split along it, so the hole has exactly\nthe box's shape. Count: triangles cut or removed.",
          "properties": {
            "box": {
              "$ref": "#/$defs/BoxRegion"
            },
            "op": {
              "const": "carveBox",
              "type": "string"
            }
          },
          "required": [
            "op",
            "box"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Smooth the surface inside the box (everywhere without one). The default Taubin method removes noise without\nshrinking the shape; `laplacian` relaxes harder and does shrink. Count: vertices moved.",
          "properties": {
            "box": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BoxRegion"
                },
                {
                  "type": "null"
                }
              ]
            },
            "iterations": {
              "default": 1,
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "keepBoundary": {
              "default": true,
              "description": "Keep vertices on open edges (hole rims, outlines) where they are.",
              "type": "boolean"
            },
            "method": {
              "$ref": "#/$defs/SmoothMethod",
              "default": "taubin"
            },
            "op": {
              "const": "smooth",
              "type": "string"
            },
            "strength": {
              "default": 0.5,
              "description": "0..1, how far each pass moves a vertex toward the average of its neighbours.",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Merge vertices on a grid of `cell` meters: fast and uniform, but rounds off detail. Prefer `simplify`.\nCount: faces left.",
          "properties": {
            "cell": {
              "format": "double",
              "type": "number"
            },
            "op": {
              "const": "decimate",
              "type": "string"
            }
          },
          "required": [
            "op",
            "cell"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Reduce the face count by collapsing the edges whose removal changes the shape least (quadric error metric),\nkeeping the surface manifold and its faces unflipped. Give `targetFaces` or `targetRatio` (0..1 of the current\ncount; default 0.5). Count: faces left.",
          "properties": {
            "keepBoundary": {
              "default": true,
              "description": "Keep open edges (hole rims, outlines) in shape.",
              "type": "boolean"
            },
            "op": {
              "const": "simplify",
              "type": "string"
            },
            "targetFaces": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "targetRatio": {
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A brush stroke: each dab moves or recolours the vertices within `radius` of its centre, with a smooth falloff.\nDabs apply in order, so a stroke sent in pieces gives the same mesh as the whole stroke. Count: vertices\ntouched.",
          "properties": {
            "brush": {
              "$ref": "#/$defs/Brush"
            },
            "color": {
              "default": [
                180,
                180,
                180
              ],
              "description": "The paint brush's colour.",
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "dabs": {
              "items": {
                "$ref": "#/$defs/Dab"
              },
              "type": "array"
            },
            "invert": {
              "default": false,
              "description": "Lower instead of raise (draw, inflate) or spread instead of gather (pinch).",
              "type": "boolean"
            },
            "op": {
              "const": "sculpt",
              "type": "string"
            },
            "radius": {
              "description": "Meters.",
              "format": "double",
              "type": "number"
            },
            "strength": {
              "default": 0.5,
              "description": "0..1 per dab.",
              "format": "double",
              "type": "number"
            },
            "view": {
              "description": "Direction the brush points (camera toward surface). Normals are turned to face it, so `draw` raises the\nsurface toward the person sculpting even where a scan's winding is unreliable.",
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": [
                "array",
                "null"
              ]
            }
          },
          "required": [
            "op",
            "brush",
            "dabs",
            "radius"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Close holes (boundary loops of up to `maxEdges` edges). Each loop is triangulated in its best-fit plane by\near clipping, so concave holes close cleanly without new vertices. Count: faces added.",
          "properties": {
            "maxEdges": {
              "default": 64,
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "fillHoles",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Split edges longer than `maxEdge` meters (only inside the box when given) so flat faces can hold detail.\nCount: faces after.",
          "properties": {
            "box": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BoxRegion"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxEdge": {
              "format": "double",
              "type": "number"
            },
            "maxFaces": {
              "default": 900000,
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "subdivide",
              "type": "string"
            },
            "passes": {
              "default": 6,
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "op",
            "maxEdge"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Push vertices along their normals by fractal noise: chips, pitting, uneven stone. Count: vertices moved.",
          "properties": {
            "amplitude": {
              "description": "Largest displacement, meters.",
              "format": "double",
              "type": "number"
            },
            "box": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BoxRegion"
                },
                {
                  "type": "null"
                }
              ]
            },
            "edge": {
              "default": 0.0,
              "description": "Meters over which the effect eases off toward the box boundary.",
              "format": "double",
              "type": "number"
            },
            "octaves": {
              "default": 4,
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "roughen",
              "type": "string"
            },
            "ridged": {
              "default": false,
              "description": "Crack-like ridges instead of soft lumps.",
              "type": "boolean"
            },
            "scale": {
              "description": "Feature size, meters.",
              "format": "double",
              "type": "number"
            },
            "seed": {
              "default": 1,
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "op",
            "amplitude",
            "scale"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Vary vertex colours with noise. Count: vertices changed.",
          "properties": {
            "a": {
              "default": [
                128,
