              "default": 0.5,
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Colour the vertices in the box from the nearest source vertex within `maxDist`: the document's reference mesh\nwith `fromReference`, otherwise this mesh's vertices outside the box. Count: vertices recoloured.",
          "properties": {
            "box": {
              "$ref": "#/$defs/BoxRegion"
