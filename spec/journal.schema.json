          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Copy the faces whose centre is in the box, moved by `offset`, turned about the box's vertical axis and\noptionally mirrored. Count: faces added.",
          "properties": {
            "box": {
              "$ref": "#/$defs/BoxRegion"
            },
            "mirrorX": {
              "default": false,
              "type": "boolean"
            },
            "mirrorZ": {
