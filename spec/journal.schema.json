        },
        {
          "additionalProperties": false,
          "description": "Bake ambient occlusion into the vertex colours. Run once. Count: vertices shaded.",
          "properties": {
            "box": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BoxRegion"
                },
                {
