                  "type": "null"
                }
              ]
            },
            "mode": {
              "$ref": "#/$defs/TintMode",
              "default": "mix"
            },
            "octaves": {
              "default": 3,
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "tint",
              "type": "string"
            },
            "scale": {
              "format": "double",
              "type": "number"
            },
            "seed": {
              "default": 1,
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "strength": {
              "description": "0..1.",
              "format": "double",
              "type": "number"
            },
            "stretch": {
              "default": [
                1.0,
                1.0,
